OPENAI_PROVIDER=gpustack

# OPENAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5-2026-04-23

# For Azure OpenAI workshops, set OPENAI_PROVIDER=azure and fill these.
# Your deployment name is used as the chat model for Azure requests.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT="gpt-4.1"
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# For GPUStack, set OPENAI_PROVIDER=gpustack. (default)
GPUSTACK_API_KEY=
GPUSTACK_BASE_URL=https://gpustack.unibe.ch/v1
GPUSTACK_MODEL=gpt-oss-120b

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_NAME=dad-it-support-agent
LANGFUSE_PROMPT_LABEL=production

DATASET_NAME=it-support-workshop-dataset
